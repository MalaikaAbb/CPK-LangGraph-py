# CopilotKit + LangGraph (Python) test suite — environment
#
# This file covers BOTH processes. Copy it twice and delete the block that does
# not apply to each:
#
#   cp .env.example backend/.env
#   cp .env.example frontend/.env.local
#
# The only variable you must fill in is OPENAI_API_KEY in backend/.env.


# ─────────────────────────────────────────────────────────────────────────────
# backend/.env — read by the Python agent server
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Every graph runs on OpenAI. Server-side only; never reaches the
# browser.  https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Which of the Quickstart's two deployment tabs this backend is serving.
#   fastapi    — `python main.py` mounts every graph at /{graph_id}.
#                Graphs compile with MemorySaver.
#   langsmith  — `langgraph dev` serves the graphs in langgraph.json.
#                Graphs compile without a checkpointer; the platform owns it.
# Must match LANGGRAPH_TRANSPORT in frontend/.env.local.
LANGGRAPH_TRANSPORT=langsmith

# Where the FastAPI agent server listens. Ignored under the langsmith
# transport, where `langgraph dev --port` decides.
AGENT_HOST=0.0.0.0
AGENT_PORT=8123

# Uvicorn / LangGraph log level.
LOG_LEVEL=INFO

# Optional model overrides. Defaults are gpt-4.1-mini for every graph, and
# o4-mini for the two reasoning routes — a reasoning-capable model is the only
# way those routes emit the reasoning cards they exist to show. See README §9
# for why the docs' own `gpt-5.4` is not used.
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_REASONING_MODEL=o4-mini


# ─────────────────────────────────────────────────────────────────────────────
# frontend/.env.local — read by the Next.js process
# ─────────────────────────────────────────────────────────────────────────────

# Must match the backend's LANGGRAPH_TRANSPORT. Decides which agent class the
# Copilot Runtime builds:
#   fastapi    -> new LangGraphHttpAgent({ url: `${LANGGRAPH_DEPLOYMENT_URL}/${id}` })
#   langsmith  -> new LangGraphAgent({ deploymentUrl, graphId: id, langsmithApiKey })
LANGGRAPH_TRANSPORT=langsmith

# Where the agent server is. One name for both transports, as the Quickstart
# uses it. If chats hang rather than error, try 127.0.0.1 instead of localhost.
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123

# Only the langsmith transport needs this. Leave empty on fastapi.
LANGSMITH_API_KEY=

# Optional. Whisper transcription for the microphone on /voice, and nothing
# else. This is the one key that lives on the frontend process. Without it the
# mic returns a clean 401 and the route still works via its sample-audio button.
# OPENAI_API_KEY=your_openai_api_key

# Optional. Point transcription at a proxy without redirecting the chat model.
# OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1

# Optional. Set to `off` to disable the CopilotKit Inspector app-wide.
# Otherwise it is on for localhost only.
# NEXT_PUBLIC_COPILOTKIT_INSPECTOR=off

# ── frontend/.env.local — CopilotKit Intelligence (optional) ─────────────────
#
# Two independent switches. They fail differently, which is the single most
# confusing thing about Rich Threads:
#
#   INTELLIGENCE_API_KEY   turns the runtime into Intelligence mode, so threads
#                          persist and the thread endpoints return real rows.
#   a license credential   is what client-side feature UIs gate on. Without one
#                          <CopilotThreadsDrawer> renders its locked "Upgrade"
#                          view even while threads work perfectly.
#
# With neither, the runtime falls back to SSE with an in-memory runner. Every
# chat route still works; the three Rich Threads routes have nothing durable to
# list. The /quickstart page reports which of these the running app actually
# has, read from the server at render time.

# Server-side secret. NEVER prefix this NEXT_PUBLIC_ — that ships it in the
# browser bundle. Get one at https://dashboard.operations.copilotkit.ai/
# INTELLIGENCE_API_KEY=

# License, server side. The runtime builds a license checker from it and /info
# reports licenseStatus off that checker.
# COPILOTKIT_LICENSE_TOKEN=

# License, client side — the form the Threads Drawer doc's own sample passes.
# Either this or COPILOTKIT_LICENSE_TOKEN unlocks the drawer. Genuinely public,
# unlike INTELLIGENCE_API_KEY.
# NEXT_PUBLIC_COPILOTKIT_PUBLIC_LICENSE_KEY=ck_pub_...

# Threads are per-user: identifyUser on the runtime reads these headers, which
# the provider sends. A real app derives them from a verified session; a local
# harness has none, so change these to watch two thread lists diverge.
# NEXT_PUBLIC_DEMO_USER_ID=harness-local
# NEXT_PUBLIC_DEMO_USER_NAME=Harness User
